{
  "name": "@invoice/backend",
  "version": "1.0.0",
  "private": true,
  "description": "Backend NestJS para generación de facturas PDF y envío por email",
  "scripts": {
    "build": "nest build",
    "dev": "ts-node --watch --transpile-only src/main.ts",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "test": "jest --config jest.config.js",
    "test:unit": "jest --config jest.config.js --testPathPattern='\\.unit\\.spec\\.ts$'",
    "test:integration": "jest --config jest.config.js --testPathPattern='\\.integration\\.spec\\.ts$'",
    "test:cov": "jest --config jest.config.js --coverage",
    "lint": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.ts\""
  },
  "dependencies": {
    "@invoice/shared": "workspace:*",
    "@nestjs/common": "^10.4.15",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.15",
    "@nestjs/platform-express": "^10.4.15",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "joi": "^17.13.3",
    "pdfmake": "^0.2.19",
    "reflect-metadata": "^0.2.2",
    "resend": "^4.0.1",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.9",
    "@nestjs/schematics": "^10.2.3",
    "@nestjs/testing": "^10.4.15",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.9.0",
    "@types/pdfmake": "^0.2.9",
    "jest": "^29.7.0",
    "supertest": "^7.0.0",
    "@types/supertest": "^6.0.2",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3",
    "prettier": "^3.3.3"
  }
}