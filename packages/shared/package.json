{
  "name": "@invoice/shared",
  "version": "1.0.0",
  "private": true,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -w -p tsconfig.json",
    "test": "jest --config jest.config.js --passWithNoTests",
    "test:unit": "jest --config jest.config.js --testPathPattern='\\.unit\\.spec\\.ts$' --passWithNoTests",
    "test:integration": "jest --config jest.config.js --testPathPattern='\\.integration\\.spec\\.ts$' --passWithNoTests",
    "lint": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.ts\""
  },
  "dependencies": {
    "class-validator": "^0.14.1",
    "class-transformer": "^0.5.1"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "typescript": "^5.6.3",
    "prettier": "^3.3.3"
  }
}